<?xml version="1.0" encoding="utf-8"?>
<!--
  Main Exo player view that renders video through a TextureView instead of a SurfaceView.
  Needed for zoom/crop on TVs whose hardware video plane cannot clip a SurfaceView that is
  larger than the screen (the whole frame gets squeezed instead of cropped). A TextureView is
  composited by the GPU, so scale/crop transforms are exact.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never" />
